<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lab6"
        xmlns:rendering="clr-namespace:Lab6.Rendering"
        x:Class="Lab6.MainWindow"
        Title="Lab6 — 3D Graphics"
        Width="1280" Height="800">
  <Grid ColumnDefinitions="340,*">
    <ScrollViewer Grid.Column="0">
      <StackPanel Margin="8" Spacing="4">

        <!-- Platonic solids -->
        <TextBlock Text="Правильные многогранники" FontWeight="Bold"/>
        <WrapPanel>
          <Button Content="Тетраэдр"  Command="{Binding CreateTetrahedronCommand}"  Margin="2"/>
          <Button Content="Гексаэдр"  Command="{Binding CreateHexahedronCommand}"   Margin="2"/>
          <Button Content="Октаэдр"   Command="{Binding CreateOctahedronCommand}"   Margin="2"/>
          <Button Content="Икосаэдр"  Command="{Binding CreateIcosahedronCommand}"  Margin="2"/>
          <Button Content="Додекаэдр" Command="{Binding CreateDodecahedronCommand}" Margin="2"/>
        </WrapPanel>

        <!-- Translation -->
        <TextBlock Text="Смещение" FontWeight="Bold" Margin="0,8,0,0"/>
        <Grid ColumnDefinitions="*,*,*">
          <TextBox Grid.Column="0" Text="{Binding TranslateX}" Watermark="X" Margin="2"/>
          <TextBox Grid.Column="1" Text="{Binding TranslateY}" Watermark="Y" Margin="2"/>
          <TextBox Grid.Column="2" Text="{Binding TranslateZ}" Watermark="Z" Margin="2"/>
        </Grid>
        <Button Content="Применить смещение" Command="{Binding ApplyTranslationCommand}"/>

        <!-- Rotation about coordinate axis (through model center) -->
        <TextBlock Text="Поворот вокруг оси" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding RotationAngle}" Watermark="Угол (град.)"/>
        <ComboBox SelectedItem="{Binding RotationAxis}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="X"/>
          <ComboBoxItem Content="Y"/>
          <ComboBoxItem Content="Z"/>
        </ComboBox>
        <Button Content="Повернуть" Command="{Binding ApplyRotationCommand}"/>

        <!-- Scale -->
        <TextBlock Text="Масштаб" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding ScaleFactor}" Watermark="Коэффициент"/>
        <Button Content="Масштабировать относительно центра" Command="{Binding ApplyScaleCommand}"/>

        <!-- Reflection -->
        <TextBlock Text="Отражение" FontWeight="Bold" Margin="0,8,0,0"/>
        <ComboBox SelectedItem="{Binding ReflectionPlane}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="XY"/>
          <ComboBoxItem Content="XZ"/>
          <ComboBoxItem Content="YZ"/>
        </ComboBox>
        <Button Content="Отразить" Command="{Binding ApplyReflectionCommand}"/>

        <!-- Rotation about arbitrary line -->
        <TextBlock Text="Поворот вокруг произвольной прямой" FontWeight="Bold" Margin="0,8,0,0"/>
        <Grid ColumnDefinitions="*,*,*">
          <TextBox Grid.Column="0" Text="{Binding AxisPointX}" Watermark="Px" Margin="2"/>
          <TextBox Grid.Column="1" Text="{Binding AxisPointY}" Watermark="Py" Margin="2"/>
          <TextBox Grid.Column="2" Text="{Binding AxisPointZ}" Watermark="Pz" Margin="2"/>
        </Grid>
        <Grid ColumnDefinitions="*,*,*">
          <TextBox Grid.Column="0" Text="{Binding AxisDirectionX}" Watermark="Dx" Margin="2"/>
          <TextBox Grid.Column="1" Text="{Binding AxisDirectionY}" Watermark="Dy" Margin="2"/>
          <TextBox Grid.Column="2" Text="{Binding AxisDirectionZ}" Watermark="Dz" Margin="2"/>
        </Grid>
        <TextBox Text="{Binding CustomRotationAngle}" Watermark="Угол (град.)"/>
        <Button Content="Повернуть" Command="{Binding ApplyCustomRotationCommand}"/>

        <!-- Projection -->
        <TextBlock Text="Проекция" FontWeight="Bold" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Перспективная"      Command="{Binding SetPerspectiveCommand}"/>
          <Button Content="Аксонометрическая"  Command="{Binding SetAxonometricCommand}"/>
        </StackPanel>

        <!-- File I/O -->
        <TextBlock Text="Файл" FontWeight="Bold" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Загрузить OBJ"  Command="{Binding LoadModelCommand}"/>
          <Button Content="Сохранить OBJ"  Command="{Binding SaveModelCommand}"/>
        </StackPanel>

        <!-- Revolution -->
        <TextBlock Text="Фигура вращения" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding RevolutionSegments}" Watermark="Количество разбиений"/>
        <ComboBox SelectedItem="{Binding RevolutionAxis}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="X"/>
          <ComboBoxItem Content="Y"/>
          <ComboBoxItem Content="Z"/>
        </ComboBox>
        <Button Content="Построить фигуру вращения" Command="{Binding BuildRevolutionCommand}"/>

        <!-- Surface -->
        <TextBlock Text="График поверхности f(x,y)" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Text="{Binding SurfaceFunction}" Watermark="f(x,y)"/>
        <Grid ColumnDefinitions="*,*">
          <TextBox Grid.Column="0" Text="{Binding SurfaceXMin}" Watermark="x0" Margin="2"/>
          <TextBox Grid.Column="1" Text="{Binding SurfaceXMax}" Watermark="x1" Margin="2"/>
        </Grid>
        <Grid ColumnDefinitions="*,*">
          <TextBox Grid.Column="0" Text="{Binding SurfaceYMin}" Watermark="y0" Margin="2"/>
          <TextBox Grid.Column="1" Text="{Binding SurfaceYMax}" Watermark="y1" Margin="2"/>
        </Grid>
        <TextBox Text="{Binding SurfaceSegments}" Watermark="Разбиений по осям"/>
        <Button Content="Построить поверхность" Command="{Binding BuildSurfaceCommand}"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
      <rendering:SceneControl x:Name="Scene"/>
    </Border>
  </Grid>
</Window>